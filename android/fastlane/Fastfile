default_platform(:android)

SECURE_ENV_PATH = File.expand_path("~/Mayday/Secure/RotorReady/GooglePlay/playstore.env")

def load_secure_env(path = ENV["ROTORREADY_GOOGLEPLAY_ENV"] || SECURE_ENV_PATH)
  UI.user_error!("Google Play env file not found: #{path}") unless File.exist?(path)

  File.readlines(path).each do |line|
    line = line.strip
    next if line.empty? || line.start_with?("#") || !line.include?("=")

    key, value = line.split("=", 2)
    ENV[key] ||= value
  end
end

def required_env(name)
  value = ENV[name]
  UI.user_error!("Missing #{name}. Check #{SECURE_ENV_PATH}") if value.to_s.empty?
  value
end

def play_track
  ENV["GOOGLE_PLAY_TRACK"].to_s.empty? ? "internal" : ENV["GOOGLE_PLAY_TRACK"]
end

def current_version_code
  gradle_path = File.expand_path("../app/build.gradle", __dir__)
  contents = File.read(gradle_path)
  match = contents.match(/versionCode\s+(\d+)/)
  UI.user_error!("Could not find versionCode in #{gradle_path}") unless match
  match[1].to_i
end

platform :android do
  before_all do
    load_secure_env
    UI.message("Using Google Play API for #{required_env('GOOGLE_PLAY_PACKAGE_NAME')}")
  end

  desc "Validate Google Play API access without uploading a build"
  desc "Print the version codes on each Play track (read-only) — mirrors the iOS status lane"
  lane :status do
    # Lists each release with its status. Version codes alone were misleading: after a
    # submit_review, production showed "14, 13" with nothing saying 14 was only a draft.
    # Opens an edit to read the tracks and always aborts it, so nothing is ever changed.
    require "supply"
    package_name = required_env("GOOGLE_PLAY_PACKAGE_NAME")
    client = Supply::Client.make_from_config(params: {
      json_key: required_env("GOOGLE_PLAY_JSON_KEY_PATH"),
      package_name: package_name
    })
    client.begin_edit(package_name: package_name)
    begin
      order = %w[production beta alpha internal]
      client.tracks.sort_by { |t| order.index(t.track) || order.length }.each do |track|
        releases = (track.releases || []).map do |r|
          "#{(r.version_codes || []).join('+')} #{r.name.to_s.empty? ? '' : "(#{r.name}) "}— #{r.status}"
        end
        UI.important("#{track.track}: #{releases.empty? ? 'no release' : releases.join(' | ')}")
      end
    ensure
      client.abort_current_edit
    end
  end

  lane :validate_play do
    google_play_track_version_codes(
      package_name: required_env("GOOGLE_PLAY_PACKAGE_NAME"),
      json_key: required_env("GOOGLE_PLAY_JSON_KEY_PATH"),
      track: play_track
    )
    UI.success("Connected to Google Play track #{play_track}")
  end

  desc "Sync Capacitor Android assets and build a signed release AAB"
  lane :build do
    sh("cd .. && env -u GEM_PATH -u GEM_HOME npm run android:sync")
    sh("cd .. && env -u GEM_PATH -u GEM_HOME ./gradlew bundleRelease")
  end

  desc "Build and upload AAB to Google Play internal testing"
  lane :internal do
    build
    upload_to_play_store(
      package_name: required_env("GOOGLE_PLAY_PACKAGE_NAME"),
      json_key: required_env("GOOGLE_PLAY_JSON_KEY_PATH"),
      aab: "app/build/outputs/bundle/release/app-release.aab",
      track: play_track,
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Build and submit a new release directly to production for review, as a draft"
  desc "Goes through Google Play review like a normal production release, but release_status:"
  desc "draft means it won't actually go live until the user manually starts the rollout"
  desc "in Play Console — the same 'reviewed, then you push it through' shape as iOS's"
  desc "submit_review lane."
  lane :submit_review do
    build
    upload_to_play_store(
      package_name: required_env("GOOGLE_PLAY_PACKAGE_NAME"),
      json_key: required_env("GOOGLE_PLAY_JSON_KEY_PATH"),
      aab: "app/build/outputs/bundle/release/app-release.aab",
      track: "production",
      release_status: "draft",
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote the current internal testing release to production — no new build/upload"
  lane :promote_to_production do
    upload_to_play_store(
      package_name: required_env("GOOGLE_PLAY_PACKAGE_NAME"),
      json_key: required_env("GOOGLE_PLAY_JSON_KEY_PATH"),
      track: "internal",
      track_promote_to: "production",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload store listing text and changelogs from fastlane/metadata/android — no new build"
  lane :metadata do
    upload_to_play_store(
      package_name: required_env("GOOGLE_PLAY_PACKAGE_NAME"),
      json_key: required_env("GOOGLE_PLAY_JSON_KEY_PATH"),
      track: play_track,
      version_code: current_version_code,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end