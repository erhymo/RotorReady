      "id": "avfms-001",
      "section": "Avionics & FMS Limitations",
      "type": "single",
      "question": "Is intentional P/R - C/Y trim de-clutching (in EDCU TRIM page) flight allowed?",
      "options": [
        "Yes, always",
        "Yes, but only in HOV mode",
        "No, it is prohibited",
        "Only if both APs are engaged"
      ],
      "answer": [
        2
      ],
      "explanation": "Intentional P/R–C/Y trim de-clutching (EDCU TRIM page) in flight is prohibited.",
      "references": [
        "QRH Avionics Limitations p.1"
      ],
      "sectionId": "avionics_fms_limitations",
      "modelIds": [
        "AW169_EP"
      ],
      "source": "AW169 QRH",
      "tags": []
    },
    {
      "id": "avfms-002",
      "section": "Avionics & FMS Limitations",
      "type": "single",
      "question": "AFCS upper modes must be disengaged, except HOV, TDH, TU, and coupled approach modes, if which of the following occurs?",
      "options": [
        "Loss of radio communication",
        "Failure of one autopilot (AP)",
        "Low hydraulic pressure",
        "Both AHRS units operating normally"
      ],
      "answer": [
        1
      ],
      "explanation": "AFCS upper modes (except HOV, TDH, TU, and coupled approach modes) must be disengaged after failure of one AP, one AHRS, or ADI-STDBY, after an actuator failure, loss of CAS messages, or an AFCS oscillatory malfunction.",
      "references": [
        "QRH Avionics Limitations p.1"
      ],
      "sectionId": "avionics_fms_limitations",
      "modelIds": [
        "AW169_EP"
      ],
      "source": "AW169 QRH",
      "tags": []
    },
