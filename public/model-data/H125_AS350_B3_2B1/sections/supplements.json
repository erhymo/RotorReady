    {
      "id": "H125-SUP-001",
      "question": "What is the emergency floatation gear approved for?",
      "options": [
        "Ditching in all sea states",
        "Emergency landing on water only, not ditching",
        "Continuous flight over water",
        "Takeoff from water"
      ],
      "answer": [
        1
      ],
      "explanation": "SUP.17: the gear is approved for emergency use (not for ditching according to JAR 27) to keep the rotorcraft upright for evacuation. Takeoff after an emergency landing on water is prohibited.",
